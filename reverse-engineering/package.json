{
  "name": "gravit-reverse-engineering",
  "version": "2.0.0",
  "description": "Complete reverse engineering toolkit for Gravit Designer",
  "main": "index.js",
  "scripts": {
    "beautify": "node beautify.js",
    "extract": "node extract-modules.js",
    "extract-app": "node extract-all-modules.cjs",
    "extract-vendor": "node extract-modules-ast.js",
    "extract-vendors": "node process-other-vendors.js",
    "discover": "node discover-classes.cjs && node refine-map.cjs",
    "recategorize": "node recategorize-modules.cjs",
    "build-app": "node build-bundle.cjs",
    "build-vendor": "node build-vendor.cjs",
    "build-all-bundles": "node build-bundle.cjs && node build-vendor.cjs",
    "unbundle": "node unbundle.js",
    "compare": "node compare-sources.js",
    "reconstruct": "node reconstruct-source.js",
    "build": "webpack --mode development",
    "build:prod": "webpack --mode production",
    "dev": "webpack serve --mode development",
    "analyze": "node analyze-classes.js",
    "rename": "node rename-variables.js",
    "all": "node build-all.js",
    "build-all": "node build-all.js",
    "use-dev": "node -e \"const fs=require('fs'),p=require('path'),d=p.join(__dirname,'..','public');fs.copyFileSync(p.join(d,'chunk.vendor.dev.js'),p.join(d,'chunk.vendor.js'));fs.copyFileSync(p.join(d,'designer.browser.dev.js'),p.join(d,'designer.browser.js'));console.log('Switched to dev bundles')\"",
    "use-orig": "node -e \"const fs=require('fs'),p=require('path'),d=p.join(__dirname,'..','public');fs.copyFileSync(p.join(d,'chunk.vendor.original.js'),p.join(d,'chunk.vendor.js'));fs.copyFileSync(p.join(d,'designer.browser.original.js'),p.join(d,'designer.browser.js'));console.log('Restored original bundles')\"",
    "quick": "npm run beautify && npm run extract-vendor && npm run extract-vendors",
    "full-extract": "npm run extract && npm run extract-vendor && npm run extract-vendors && npm run discover && npm run recategorize"
  },
  "keywords": ["gravit", "reverse-engineering", "decompiler"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "fs-extra": "^11.3.3",
    "acorn": "^8.11.0",
    "acorn-walk": "^8.3.0",
    "astring": "^1.8.6",
    "escodegen": "^2.1.0",
    "esprima": "^4.0.1",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "html-webpack-plugin": "^5.5.3",
    "terser-webpack-plugin": "^5.3.9"
  }
}
